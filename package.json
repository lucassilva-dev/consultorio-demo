{
  "name": "cv2-admin-site",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page with secure admin dashboard for content editing.",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/prepare-static.js",
    "predev": "node scripts/prepare-static.js",
    "dev": "node --watch src/server.js",
    "prestart": "node scripts/prepare-static.js",
    "start": "node src/server.js",
    "migrate": "node src/db/run-migrations.js",
    "migrate:prod": "node scripts/migrate-production.js",
    "admin:hash": "node scripts/generate-password-hash.js",
    "test": "node --test --test-concurrency=1 tests/admin.test.js",
    "smoke": "node scripts/smoke-test.js",
    "verify:postgres": "node scripts/verify-postgres.js"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.54.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "sanitize-html": "^2.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
