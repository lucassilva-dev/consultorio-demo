# Local development with SQLite + local uploads
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-with-a-long-random-string
AUTH_COOKIE_SECRET=change-me-with-a-second-long-random-string
DATA_PROVIDER=sqlite
STORAGE_PROVIDER=local
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2$sha256$310000$replace-salt$replace-hash

# Free production path: Vercel Hobby + Supabase Free
# NODE_ENV=production
# DATA_PROVIDER=postgres
# STORAGE_PROVIDER=supabase
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# RUN_DATABASE_MIGRATIONS_ON_BOOT=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=site-images
# SUPABASE_PRIVATE_STORAGE_BUCKET=private-documents
# TOKEN_ENCRYPTION_KEY=base64-32-bytes-here
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/admin/google-calendar/callback
# GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.calendarlist.readonly
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=pbkdf2$sha256$310000$replace-salt$replace-hash
# AUTH_COOKIE_SECRET=change-me-with-a-long-random-string
# Optional only for temporary legacy token decryption during migration from old environments:
# GOOGLE_TOKEN_ENCRYPTION_SECRET=legacy-secret-used-before-token-encryption-key
